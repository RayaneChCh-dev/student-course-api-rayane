{
  "openapi": "3.0.0",
  "info": {
    "title": "StudentCourseAPI",
    "version": "1.0.0",
    "description": "API pédagogique pour gérer étudiants et cours (no DB)",
    "contact": {
      "name": "Efrei - Tests et Qualité",
      "email": "support@efrei.fr"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Serveur de développement"
    }
  ],
  "tags": [
    {
      "name": "Students",
      "description": "Gestion des étudiants"
    },
    {
      "name": "Courses",
      "description": "Gestion des cours"
    },
    {
      "name": "Enrollments",
      "description": "Gestion des inscriptions"
    }
  ],
  "paths": {
    "/students": {
      "get": {
        "tags": ["Students"],
        "summary": "Liste des étudiants",
        "description": "Retourne tous les étudiants avec pagination et filtres optionnels",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Numéro de page",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Nombre d'éléments par page",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Filtrer par nom (recherche partielle)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "description": "Filtrer par email (recherche partielle)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des étudiants",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "students": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Student"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "description": "Nombre total d'étudiants"
                    }
                  }
                },
                "example": {
                  "students": [
                    {
                      "id": 1,
                      "name": "Alice",
                      "email": "alice@example.com"
                    },
                    {
                      "id": 2,
                      "name": "Bob",
                      "email": "bob@example.com"
                    }
                  ],
                  "total": 3
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Students"],
        "summary": "Créer un étudiant",
        "description": "Ajoute un nouvel étudiant. L'email doit être unique.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentInput"
              },
              "example": {
                "name": "John Doe",
                "email": "john@example.com"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Étudiant créé avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                },
                "example": {
                  "id": 4,
                  "name": "John Doe",
                  "email": "john@example.com"
                }
              }
            }
          },
          "400": {
            "description": "Erreur de validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "duplicate_email": {
                    "value": {
                      "error": "Email must be unique"
                    }
                  },
                  "missing_fields": {
                    "value": {
                      "error": "name and email required"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/students/{id}": {
      "get": {
        "tags": ["Students"],
        "summary": "Récupérer un étudiant",
        "description": "Retourne les détails d'un étudiant et ses cours",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de l'étudiant",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Détails de l'étudiant",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "student": {
                      "$ref": "#/components/schemas/Student"
                    },
                    "courses": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Course"
                      }
                    }
                  }
                },
                "example": {
                  "student": {
                    "id": 1,
                    "name": "Alice",
                    "email": "alice@example.com"
                  },
                  "courses": [
                    {
                      "id": 1,
                      "title": "Math",
                      "teacher": "Mr. Smith"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Étudiant non trouvé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Student not found"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Students"],
        "summary": "Modifier un étudiant",
        "description": "Met à jour les informations d'un étudiant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de l'étudiant",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentInput"
              },
              "example": {
                "name": "Alice Updated",
                "email": "alice-new@example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Étudiant modifié",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "400": {
            "description": "Email déjà utilisé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Email must be unique"
                }
              }
            }
          },
          "404": {
            "description": "Étudiant non trouvé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Student not found"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Students"],
        "summary": "Supprimer un étudiant",
        "description": "Supprime un étudiant (impossible s'il est inscrit à un cours)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de l'étudiant",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Étudiant supprimé"
          },
          "400": {
            "description": "Étudiant inscrit à un cours",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Cannot delete student: enrolled in a course"
                }
              }
            }
          },
          "404": {
            "description": "Étudiant non trouvé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Student not found"
                }
              }
            }
          }
        }
      }
    },
    "/courses": {
      "get": {
        "tags": ["Courses"],
        "summary": "Liste des cours",
        "description": "Retourne tous les cours avec pagination et filtres optionnels",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Numéro de page",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Nombre d'éléments par page",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "title",
            "in": "query",
            "description": "Filtrer par titre (recherche partielle)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "teacher",
            "in": "query",
            "description": "Filtrer par enseignant (recherche partielle)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des cours",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "courses": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Course"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "description": "Nombre total de cours"
                    }
                  }
                },
                "example": {
                  "courses": [
                    {
                      "id": 1,
                      "title": "Math",
                      "teacher": "Mr. Smith"
                    },
                    {
                      "id": 2,
                      "title": "Physics",
                      "teacher": "Dr. Brown"
                    }
                  ],
                  "total": 3
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Courses"],
        "summary": "Créer un cours",
        "description": "Ajoute un nouveau cours. Le titre doit être unique.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CourseInput"
              },
              "example": {
                "title": "Chemistry",
                "teacher": "Dr. Green"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cours créé avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                },
                "example": {
                  "id": 4,
                  "title": "Chemistry",
                  "teacher": "Dr. Green"
                }
              }
            }
          },
          "400": {
            "description": "Erreur de validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "duplicate_title": {
                    "value": {
                      "error": "Course title must be unique"
                    }
                  },
                  "missing_fields": {
                    "value": {
                      "error": "title and teacher required"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/courses/{id}": {
      "get": {
        "tags": ["Courses"],
        "summary": "Récupérer un cours",
        "description": "Retourne les détails d'un cours et ses étudiants inscrits",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID du cours",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Détails du cours",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "course": {
                      "$ref": "#/components/schemas/Course"
                    },
                    "students": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Student"
                      }
                    }
                  }
                },
                "example": {
                  "course": {
                    "id": 1,
                    "title": "Math",
                    "teacher": "Mr. Smith"
                  },
                  "students": [
                    {
                      "id": 1,
                      "name": "Alice",
                      "email": "alice@example.com"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Cours non trouvé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Course not found"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Courses"],
        "summary": "Modifier un cours",
        "description": "Met à jour les informations d'un cours",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID du cours",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CourseInput"
              },
              "example": {
                "title": "Advanced Math",
                "teacher": "Prof. Smith"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cours modifié",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            }
          },
          "400": {
            "description": "Titre déjà utilisé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Course title must be unique"
                }
              }
            }
          },
          "404": {
            "description": "Cours non trouvé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Course not found"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Courses"],
        "summary": "Supprimer un cours",
        "description": "Supprime un cours (suppression en cascade des inscriptions)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID du cours",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Cours supprimé"
          },
          "404": {
            "description": "Cours non trouvé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Course not found"
                }
              }
            }
          }
        }
      }
    },
    "/courses/{courseId}/students/{studentId}": {
      "post": {
        "tags": ["Enrollments"],
        "summary": "Inscrire un étudiant à un cours",
        "description": "Ajoute un étudiant à un cours (max 3 étudiants par cours)",
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "description": "ID du cours",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "studentId",
            "in": "path",
            "required": true,
            "description": "ID de l'étudiant",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Étudiant inscrit avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "success": true
                }
              }
            }
          },
          "400": {
            "description": "Erreur d'inscription",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "course_full": {
                    "value": {
                      "error": "Course is full"
                    }
                  },
                  "already_enrolled": {
                    "value": {
                      "error": "Student already enrolled in this course"
                    }
                  },
                  "course_not_found": {
                    "value": {
                      "error": "Course not found"
                    }
                  },
                  "student_not_found": {
                    "value": {
                      "error": "Student not found"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Enrollments"],
        "summary": "Désinscrire un étudiant d'un cours",
        "description": "Retire un étudiant d'un cours",
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "description": "ID du cours",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "studentId",
            "in": "path",
            "required": true,
            "description": "ID de l'étudiant",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Étudiant désinscrit"
          },
          "404": {
            "description": "Inscription non trouvée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Enrollment not found"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Student": {
        "type": "object",
        "required": ["id", "name", "email"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID unique de l'étudiant",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Nom complet de l'étudiant",
            "example": "Alice"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email unique de l'étudiant",
            "example": "alice@example.com"
          }
        }
      },
      "StudentInput": {
        "type": "object",
        "required": ["name", "email"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nom complet de l'étudiant",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email unique de l'étudiant",
            "example": "john@example.com"
          }
        }
      },
      "Course": {
        "type": "object",
        "required": ["id", "title", "teacher"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID unique du cours",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "Titre unique du cours",
            "example": "Math"
          },
          "teacher": {
            "type": "string",
            "description": "Nom de l'enseignant",
            "example": "Mr. Smith"
          }
        }
      },
      "CourseInput": {
        "type": "object",
        "required": ["title", "teacher"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Titre unique du cours",
            "example": "Chemistry"
          },
          "teacher": {
            "type": "string",
            "description": "Nom de l'enseignant",
            "example": "Dr. Green"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Message d'erreur",
            "example": "Resource not found"
          }
        }
      }
    }
  }
}